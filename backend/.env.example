# Copy to backend/.env locally. Never commit backend/.env.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=otel_db
DB_USER=postgres
DB_PASS=replace-with-your-local-database-password
# Flask sunucusu (güvenli varsayılanlar). Debug'ı yalnızca yerelde 1 yapın.
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
